Symbol p'
Symbol t'
Symbol k'
Symbol t͡s

Class nonlow {ə, i, y, ɨ, u, e}
Class nonhigh {æ, ɑ, ø}
Class front {i, y, e, ɛ, ø, æ}
Class back {u, o, a}
Class vowel {i, y, ɨ, u, e, ø, ə, o, ɛ, œ, ɔ, æ, ɑ, a, ʊ}
Class ejective {p', t', k'}
Class stop {p, b, t, d, k, g, q, ɢ, ʔ, @ejective}
Class frequickative {θ, x, ɣ, χ, ʁ, h, ɦ}
Class fricative {f, v, s, z, t͡s, t͡ʃ, d͡ʒ, ʃ, ʒ, @frequickative}
Class nasal {m, n, ɲ, ŋ, ɴ}
Class rhotic {ɹ, r, ʀ}
Class glide {w, j}
Class liquid {@rhotic, l, ʎ}
Class approximant {@glide, @liquid}
Class affricate {t͡s}
Class voiced {b, d, g, v, z, ɦ, @nasal, @approximant}
Class voiceless {p, t, k, f, s, h}
Class sonorant {@nasal, @approximant}
Class obstruent {@stop, @fricative, @affricate}
Class consonant {@obstruent, @sonorant}

# These are the protolanguage phonemes
Class proto {p, b, t, d, k, g, f, v, s, z, h, ɦ, w, l, ɹ, j, m, n, ɲ, ŋ, i, y, ɨ, u, e, ɛ, ø, ə, o, æ, ɑ}
Class vorathic {p, b, t, d, k, g, p', t', k', ʔ, t͡s, f, v, s, z, w, l, ɹ, ʀ, j, m, n, ŋ, u, o, a}
Class abyssal {p, b, t, q, d, k, g, ɢ, p', t', k', ʔ, t͡s, f, v, s, z, χ, ʁ, w, l, j, m, n, ŋ, ɔ, ʊ, ə}
Class infernal {p, b, t, q, d, k, g, ɢ, p', t', k', ʔ, t͡s, f, v, s, z, ʁ, w, l, j, m, n, ŋ, a, o, e}

#deromanizer:
  #hh => ɦ
  #ny => ɲ
  #ng => ŋ
  #y => j
  #r => ɹ
  #ü => y
  #ï => ɨ
  #è => ɛ
  #oe => ø
  #ë => ə
  #ae => æ
  #à => ɑ

Syllables:
  (@consonant&@vorathic)? (@consonant&@vorathic)? (@consonant&@vorathic)? (@vowel&@vorathic) (@consonant&@vorathic)? (@consonant&@vorathic)?

vowel-shift:
  {u, o, a} => {ʊ, ɔ, ə}

Syllables:
  (@consonant)? (@consonant)? (@consonant)? (@vowel) (@consonant)? (@consonant)?

uvularization:
  {k, g, x} => {q, ɢ, χ} / _ ʀ

rhotic-stopifizes:
  ɹ => d / _ @stop
  ɹ => d / @stop _

rhotic-fricatifizes:
  ɹ => z / _ @fricative
  ɹ => z / @fricative _

rhotic-alveolar-loss:
  ɹ => l

rhotic-trill-loss:
  ʀ => ʁ

voicing-harmony @obstruent rtl:
    {p, t, k, q, f, s, x, χ} => {b, d, g, ɢ, v, z, ɣ, ʁ} / _ @voiced
    {b, d, g, ɢ, v, z, ɣ, ʁ} => {p, t, k, q, f, s, x, χ} / _ @voiceless

Syllables:
  (@consonant&@abyssal)? (@consonant&@abyssal)? (@consonant&@abyssal)? (@vowel&@abyssal) (@consonant&@abyssal)? (@consonant&@abyssal)?

romanizer-Abyssal:
    unchanged
